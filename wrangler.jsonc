// Cloudflare deploy: the built app in dist/ served as static files. The name must match the
// project name in the Cloudflare dashboard.
{
  "name": "ops-school-study",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Pull-request branches deploy with `npx wrangler preview`, which needs this block (empty is
  // fine). Without it every PR's Cloudflare check fails. Production deploys ignore it.
  "previews": {}
}
