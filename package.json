{
  "name": "ops-school-study",
  "private": true,
  "version": "0.1.0",
  "description": "Private study app for a banking Operations School final exam. Not for distribution.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "check:content": "tsx scripts/check-content.ts",
    "build": "npm run check:content && tsc --noEmit -p . && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
